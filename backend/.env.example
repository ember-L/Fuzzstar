# 复制为 .env 后按需填写：cp .env.example .env
# .env 已被 git 忽略，禁止提交真实密码和 Key。
# 注意：team.env 已提交到仓库并提供了团队默认值（含 SERVER_HOST / 数据库账号），
# 一般不需要再建 .env；只有想覆盖 team.env 时才复制本文件。
# 进程环境里已存在的同名变量优先，因此可以随时用 export 覆盖这里的值。

# ---- 数据库（MySQL 8，utf8mb4；运行时不使用 SQLite）----
# 连接串默认由 team.env 的 SERVER_HOST + DB_* 自动拼出，通常不用在这里写。
# 需要连别的库时，才取消下面一行并改掉：
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/rongxing?charset=utf8mb4

# ---- Docker Compose 的 MySQL 容器 ----
# docker compose 直接读取本文件：MYSQL_* 用于初始化容器，并在容器内生成 DATABASE_URL。
# 请让 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 与上面的 DATABASE_URL 保持一致。
# 这些值会拼进连接串，请使用 URL 安全字符（避免 @ : / ? #）。
MYSQL_DATABASE=rongxing
MYSQL_USER=rongxing
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---- 鉴权与协议 ----
# JWT_SECRET 至少 32 字节；用 `python -c 'import secrets; print(secrets.token_urlsafe(32))'` 生成后填入。
JWT_SECRET=replace-with-at-least-32-bytes
PRIVACY_VERSION=p1
TERMS_VERSION=t1
# 协议链接必须是 HTTPS、不带账号信息；示例地址仅供本地联调。
PRIVACY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms

# 运营管理台（/admin）的管理员账号邮箱，多个用英文逗号分隔。
# 账号必须已注册并完成邮箱验证；留空时管理台 API 返回 503。
# ADMIN_EMAILS=ops@example.com

# ---- Redis（arq worker） ----
REDIS_URL=redis://127.0.0.1:6379

# ---- 阿里云百炼 DashScope ----
# 留空时聊天/音频能力降级为规则模板，分身生成任务需要真实 Key。
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 媒体存储（S3/MinIO）----
# 需要版本控制；以下 4 项要么全填、要么全不填（只填部分会启动失败）。
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_BUCKET=rongxing-media
# MEDIA_S3_ACCESS_KEY=xxxxxxxx
# MEDIA_S3_SECRET_KEY=xxxxxxxx
# MEDIA_S3_REGION=cn-hangzhou

# ---- 邮件（SMTP）----
# 全填才启用验证邮件投递；缺任意一项时注册只写数据库队列。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=service@example.com
# SMTP_PASSWORD=xxxxxxxx
# SMTP_FROM=service@example.com
# VERIFICATION_BASE_URL=https://api.example.com/api/v1/auth/verify-email

# ---- 可选调优 ----
# RULES_DIR=/absolute/path/to/rules
# PLACEHOLDER_DIR=/absolute/path/to/placeholders
# GIF_WATERMARK_FONT=/absolute/path/to/font.ttf
# MOTION_PROVIDER=placeholder   # 萌宠动图生成实现；接真模型时注册新实现后改这里
# QUOTA_SCREENING=10
# QUOTA_AVATAR=3
# QUOTA_CHAT=50
