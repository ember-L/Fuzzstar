# ============================================================================
#  绒星 RongXing · 团队共享配置
#  本文件已提交到仓库，队友 git clone 后即可直接使用，无需自己创建 .env
#
#  【只改下面这一行】SERVER_HOST = 跑数据库那台电脑的局域网 IP
#  换 Wi-Fi / IP 变了 → 只改这一行 → 保存 → 重启后端
# ============================================================================

SERVER_HOST=10.216.251.47

# ---------------------------------------------------------------------------
# 下面一般不用动
# ---------------------------------------------------------------------------

# 数据库端口 / 库名 / 账号密码（团队统一，改动需主机同步修改 MySQL）
DB_PORT=3307
DB_NAME=rongxing
DB_USER=rongxing
DB_PASSWORD=Rongxing2026

# 管理员后台白名单（这个邮箱的账号登录不需要邮箱验证）
ADMIN_EMAILS=admin@rongxing.app

# 团队联调共用的 JWT 签名密钥（仅本地/局域网开发用；对外部署请换掉）
JWT_SECRET=rongxing-team-dev-secret-2026-only-for-lan-testing

# ---------------------------------------------------------------------------
# AI 模型：智谱 GLM（团队共享 Key，git clone 后即可用 AI 聊天/护理建议）
# 模型 glm-4-flash：速度最快、无深度思考、免费额度
# 想换模型可在本地 .env 覆盖 ZHIPU_MODEL，不要改这里
# ---------------------------------------------------------------------------
ZHIPU_API_KEY=78a225f46a414440aecf81e69c7d7637.yR6AcDQl3sNXa2K3
ZHIPU_MODEL=glm-4-flash

# ---------------------------------------------------------------------------
# 说明：
# 1. 程序启动时会先读 team.env，再读 .env；同名的变量以 .env 为准。
#    所以想临时连别的库，不要改这里，在 backend/.env 里写一行 DATABASE_URL 即可。
# 2. 只要 SERVER_HOST 填对，DATABASE_URL 会自动拼成：
#    mysql+pymysql://DB_USER:DB_PASSWORD@SERVER_HOST:DB_PORT/DB_NAME?charset=utf8mb4
# 3. 这个文件里是局域网的开发密码，不要用于公网环境。
# ---------------------------------------------------------------------------
